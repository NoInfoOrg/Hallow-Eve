; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NoInfoGame"
run/main_scene="uid://dy6vmnugwo4au"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="uid://bxl245j7738ni"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
GlobalInformation="*uid://b433wxpps0ux5"
Dialogic="*uid://ds2q0uclmolvu"

[dialogic]

directories/dch_directory={
"FREDDY D": "res://FREDDY D.dch",
"unit_test_character": "res://Tests/Resources/unit_test_character.dch"
}
directories/dtl_directory={
"tutorial": "res://tutorial.dtl",
"tutorial2": "res://tutorial2.dtl",
"tutorial3": "res://tutorial3.dtl"
}
layout/style_directory={}
glossary/default_case_sensitive=true
layout/style_list=[]
layout/default_style="Default"
variables={}

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg", "res://addons/gdscript-linter/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

